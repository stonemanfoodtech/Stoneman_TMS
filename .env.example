# Leave empty in development: Vite proxies /api to the backend (see vite.config.js).
# In production, set this to the API's public URL if the API is hosted on a different domain,
# e.g. https://api.stonemanfoodtech.com/api
VITE_API_URL=
# Where the Vite dev server forwards /api requests
VITE_API_PROXY=http://localhost:5000
